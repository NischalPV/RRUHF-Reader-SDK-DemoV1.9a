@page "/transactions"
@inject RRUHFReaderUI.Services.ReaderApiService ApiService
@rendermode InteractiveServer

<PageTitle>Transactions</PageTitle>

<h1 class="mb-4">Tag Transactions</h1>

<button class="btn btn-primary mb-3" @onclick="LoadTransactions">🔄 Refresh</button>

@if (transactions == null)
{
    <p><em>Loading...</em></p>
}
else if (!transactions.Any())
{
    <div class="alert alert-info">No transactions found</div>
}
else
{
    <div class="alert alert-success">Showing @transactions.Count recent transactions</div>
    
    <div class="table-responsive">
        <table class="table table-striped table-hover table-sm">
            <thead>
                <tr>
                    <th>Time</th>
                    <th>EPC</th>
                    <th>RSSI</th>
                    <th>Antenna</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in transactions)
                {
                    <tr>
                        <td>@tx.DetectedAt.ToLocalTime().ToString("HH:mm:ss")</td>
                        <td><code>@tx.TagEpc</code></td>
                        <td>@(tx.Rssi?.ToString("F2") ?? "-") dBm</td>
                        <td>@(tx.AntennaId?.ToString() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<RRUHFReaderUI.Models.TagTransactionDto>? transactions;

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        transactions = await ApiService.GetTransactionsAsync(limit: 100);
        StateHasChanged();
    }
}
